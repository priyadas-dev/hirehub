# Supabase (browser + server) — use your existing HireHub project values
VITE_SUPABASE_PROJECT_ID="munqgybiuqpncxbgfvdp"
VITE_SUPABASE_URL="https://munqgybiuqpncxbgfvdp.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_or_anon_key"

SUPABASE_PROJECT_ID="munqgybiuqpncxbgfvdp"
SUPABASE_URL="https://munqgybiuqpncxbgfvdp.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_publishable_or_anon_key"
# Server-only admin key for Track 1 corpus seed/embed/eval CLIs (never VITE_, never commit real values).
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# ---------------------------------------------------------------------------
# Contact form delivery via Resend (SERVER-ONLY — never use a VITE_ prefix)
# ---------------------------------------------------------------------------
# 1) Create an API key at https://resend.com
# 2) Verify a sending domain (or use a Resend test/from address they allow)
# 3) Local: copy these into `.env`, then restart `npm run dev`
# 4) Vercel: Project Settings → Environment Variables → add as Secret for
#    Production and Preview → Redeploy
#    (A local `.env` does NOT configure Vercel or Lovable automatically.)
#
RESEND_API_KEY=re_xxxxxxxx
# Always HireHub's Resend sender — never the visitor's email (visitor is reply_to).
CONTACT_FROM_EMAIL=HireHub <onboarding@resend.dev>
# Inbox that receives contact form mail. Free Resend + onboarding@resend.dev:
# this MUST be your Resend account email. Visitors can still submit from any
# address; Resend only delivers TO this inbox until you verify a domain.
# Defaults to priya.das@sjinnovation.com when unset.
CONTACT_TO_EMAIL=priya.das@sjinnovation.com

# ---------------------------------------------------------------------------
# Gemini (SERVER-ONLY — never use a VITE_ prefix)
# ---------------------------------------------------------------------------
# Used for embeddings (Track 0/1) and the AI Job Assistant text model (Track 3).
# Local: copy into `.env`, then restart `npm run dev`.
# Hosted: set as a Secret in Vercel/Lovable and redeploy.
# Docs: docs/ai-job-assistant.md
#
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding provider for corpus RAG (embed CLI + query retrieve). Must match.
#   gemini (default) — needs GEMINI_API_KEY; free tier ~1k embeds/day
#   local — free Xenova/all-mpnet-base-v2 768-dim on CPU; no Gemini key for embeds
# Do not mix providers in job_corpus without: npm run rag:reset-embeddings -- --yes
# EMBEDDING_PROVIDER=local
